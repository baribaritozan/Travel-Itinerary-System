{
  "name": "notion-itinerary-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && npx wrangler dev",
    "test": "node --test",
    "test:browser": "npm run build && node --test scripts/browser-check.mjs",
    "test:pwa": "npm run build && node scripts/recovery-build.mjs && node scripts/phase5-legacy-build.mjs && node --test scripts/pwa-check.mjs",
    "preview:phase5": "npm run build && node scripts/phase5-preview.mjs",
    "build:recovery": "node scripts/recovery-build.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "leaflet": "1.9.4",
    "playwright": "1.62.1"
  }
}
